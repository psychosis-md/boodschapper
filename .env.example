# Copy to .env.local and fill in. Never commit .env.local.
# Never give a secret the NEXT_PUBLIC_ prefix: those values ship to the browser.

# Local Docker database (docker compose up -d postgres).
# On Vercel this is set by the Neon integration.
DATABASE_URL=postgres://boodschapper:boodschapper@localhost:5432/boodschapper

# Server-only API key for the LLM provider (provider not chosen yet).
LLM_API_KEY=
